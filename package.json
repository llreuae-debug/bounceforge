{
  "name": "bounceforge",
  "version": "1.0.0",
  "description": "BounceForge - Viral Ball Physics Studio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/checkLinks.mjs",
    "check:i18n": "npx tsx scripts/testI18n.ts",
    "check:presets": "npx tsx scripts/verifyViralUpdate.ts",
    "check:sound": "npx tsx scripts/testSoundEngine.ts",
    "check:export-sound": "npx tsx scripts/testExportSound.ts",
    "check:midi": "npx tsx scripts/testMidiReel.ts",
    "check:drops": "npx tsx scripts/testDropStudio.ts",
    "test": "npx tsx scripts/testMarbleMelody.ts && npx tsx scripts/testSlowMotion.ts && npx tsx scripts/testHeadlessModes.ts && npx tsx scripts/testGrowthTools.ts",
    "test:e2e": "playwright test",
    "audit": "npm run typecheck && npm run check:sound && npm run check:export-sound && npm run check:links && npm run check:i18n && npm run check:presets && npm run check:midi && npm run check:drops && npm run test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@mediabunny/aac-encoder": "^1.61.6",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tonejs/midi": "^2.0.28",
    "@types/jszip": "^3.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "i18next": "^26.4.7",
    "i18next-icu": "^2.5.0",
    "idb-keyval": "^6.3.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.56.0",
    "mediabunny": "^1.61.6",
    "mp4-muxer": "^5.2.2",
    "postcss": "^8.5.30",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.20",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tone": "^15.1.22",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5"
  }
}
